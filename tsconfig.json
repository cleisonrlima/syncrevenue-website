{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0" /* Silences baseUrl deprecation in TS 6.x */
  },
  "include": ["src", "server", "vite.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
