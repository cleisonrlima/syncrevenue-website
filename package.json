{
  "name": "syncrevenue-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently --kill-others-on-fail \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.server.json && VITE_CJS_IGNORE_WARNING=true vite build && node scripts/generate-seo-assets.mjs && node_modules/.bin/tsx --tsconfig tsconfig.json scripts/prerender.tsx",
    "start:prod": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.scripts.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "VITE_CJS_IGNORE_WARNING=true vitest run --coverage --maxWorkers=1 --testTimeout=60000 --hookTimeout=60000",
    "db:seed": "tsx server/db.seed.ts",
    "check:client-bundle-secrets": "node scripts/check-client-bundle-secrets.mjs",
    "check:contrast": "node scripts/check-brand-contrast.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium webkit",
    "lhci": "lhci autorun --config=./lighthouserc.json",
    "lhci:mobile": "lhci autorun --config=./lighthouserc.mobile.json",
    "lint": "eslint .",
    "db:backup": "bash scripts/backup.sh",
    "test:backup": "node scripts/backup.test.mjs",
    "test:build": "node scripts/test-build-output.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.487.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.15.0",
    "react-slick": "^0.30.3",
    "recharts": "^2.15.2",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.6"
  }
}
