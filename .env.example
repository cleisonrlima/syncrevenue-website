# Dev Defaults
# Non-secret defaults below are for local development convenience only.
# Override in .env for custom values. Actual secrets must be filled in.

PORT=3001
DB_PATH=../data/sync_sirius.db
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
ALLOWED_ORIGIN=http://localhost:5173

# Public production origin for canonical SEO URLs; no trailing slash.
VITE_SITE_URL=https://syncsirius.com

# Admin seed credentials — consumed only by `npm run db:seed`.
# Never read by the running server. Leave blank in committed files.
ADMIN_EMAIL=
ADMIN_PASSWORD=
