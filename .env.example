# SyncRevenue Website — Environment Configuration
#
# Production setup:
#   1. Copy this file to .env on your VPS: cp .env.example .env
#   2. Fill in all values below (especially secrets).
#   3. Restrict file permissions: chmod 600 .env && chown <process_user>:<process_user> .env
#   4. Never commit .env to version control — it is listed in .gitignore.
#
# Secret generation:
#   JWT_SECRET:  openssl rand -hex 32
#   SMTP_PASS:   use an app password from your email provider (e.g. Gmail App Password)

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the Express server listens on.
# Default 3001 for local dev; set to 80/443 or behind a reverse proxy in production.
PORT=3001

# Path to the SQLite database file, relative to the server entry point.
# Example for production on VPS: /var/data/sync_sirius.db
DB_PATH=../data/sync_sirius.db

# ── Security ──────────────────────────────────────────────────────────────────

# Secret used to sign and verify JWT session tokens.
# MUST be a cryptographically random string of at least 32 characters.
# Generate with: openssl rand -hex 32
# Never reuse across environments; never commit the real value.
JWT_SECRET=

# Comma-separated origin allowed by CORS (no trailing slash).
# Example for production: https://syncsirius.com
ALLOWED_ORIGIN=http://localhost:5173

# ── SMTP ─────────────────────────────────────────────────────────────────────

# Hostname of the outbound SMTP server.
# Example: smtp.gmail.com
SMTP_HOST=

# SMTP port — typically 587 (STARTTLS) or 465 (SMTPS).
SMTP_PORT=587

# SMTP login username (usually an email address).
SMTP_USER=

# SMTP login password or app-specific password.
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=

# Recipient address for inbound demo-request and contact-form notifications.
NOTIFY_EMAIL=

# ── Frontend (public, non-secret) ─────────────────────────────────────────────

# Public production origin for canonical SEO URLs; no trailing slash.
# This value IS embedded in the client bundle via Vite — it is not a secret.
VITE_SITE_URL=https://syncsirius.com

# ── Dev-only seed credentials ─────────────────────────────────────────────────
# These vars are consumed ONLY by `npm run db:seed` to create the initial admin user.
# The running server does NOT read them. Leave blank in committed files.
# Never set these to real credentials in a production environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
